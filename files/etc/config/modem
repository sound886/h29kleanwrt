config global 'global'
	option enable_dial '1'
	option modem_number '1'
	option usb_scan '1'
	option pci_scan '1'
	option manual_configuration '0'
	option network_interface_alias '1'

config modem-device 'modem0'
	option data_interface 'usb'
	option driver 'usb'
	option name 'fm350-gl'
	option manufacturer 'fibocom'
	option net_driver 'rndis_host'
	option network 'eth1'
	option network_interface 'eth1'
	list ports '/dev/ttyUSB0'
	list ports '/dev/ttyUSB1'
	list ports '/dev/ttyUSB2'
	list ports '/dev/ttyUSB3'
	list ports '/dev/ttyUSB4'
	list ports '/dev/ttyUSB5'
	list ports '/dev/ttyUSB6'
	option at_port '/dev/ttyUSB3'
	option define_connect '1'
	option platform 'mediatek'
	list modes 'rndis'

config dial-config 'auto'
	option enable '1'
	option network_bridge '0'
	option network 'eth1'
	option pdp_type 'ipv4v6'
	option auth 'none'
	option apn 'auto'
